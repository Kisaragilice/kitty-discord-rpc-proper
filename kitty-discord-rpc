#!/usr/bin/env python3
import glob
import json
import os
import subprocess
import time
from pathlib import Path

from pypresence import Presence


CLIENT_ID = os.environ.get("KITTY_RPC_CLIENT_ID", "").strip()
POLL_SECONDS = float(os.environ.get("KITTY_RPC_POLL", "2"))
DEBUG = os.environ.get("KITTY_RPC_DEBUG", "0") == "1"

# Berapa lama Discord Activity dipertahankan jika semua socket
# Kitty sementara tidak bisa dibaca.
#
# Contoh:
#   pindah workspace       -> tetap tampil
#   Kitty sempat restart   -> tetap tampil beberapa detik
#   Kitty benar-benar mati -> setelah grace period, Activity di-clear
GRACE_SECONDS = float(
    os.environ.get("KITTY_RPC_GRACE_SECONDS", "10")
)

# Scan semua socket Kitty yang kita buat lewat:
# listen_on unix:/tmp/kitty-rpc-{kitty_pid}
KITTY_SOCKET_GLOB = os.environ.get(
    "KITTY_RPC_SOCKET_GLOB",
    "/tmp/kitty-rpc-*",
)

# State persistent untuk mengingat Kitty terakhir.
STATE_HOME = Path(
    os.environ.get(
        "XDG_STATE_HOME",
        str(Path.home() / ".local" / "state"),
    )
)

STATE_DIR = STATE_HOME / "kitty-discord-rpc"
LAST_KITTY_FILE = STATE_DIR / "last-kitty.json"


if not CLIENT_ID:
    raise SystemExit(
        "KITTY_RPC_CLIENT_ID is not set. "
        "Set Discord Application ID in the systemd service."
    )


